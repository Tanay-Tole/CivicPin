<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CivicPin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/on_ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorControlNormal">@color/text_tertiary</item>
        <item name="colorControlActivated">@color/ink</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <item name="materialButtonStyle">@style/Widget.CivicPin.Button</item>
        <item name="materialCardViewStyle">@style/Widget.CivicPin.Card</item>
        <item name="textInputStyle">@style/Widget.CivicPin.TextField</item>
        <item name="chipStyle">@style/Widget.CivicPin.Chip</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.CivicPin.Progress</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.CivicPin.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CivicPin.Dialog</item>
    </style>

    <style name="ThemeOverlay.CivicPin.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.CivicPin.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CivicPin.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CivicPin.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.CivicPin.Button.Text</item>
    </style>

    <style name="Shape.CivicPin.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
